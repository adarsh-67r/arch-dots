# Regenerate grub.cfg when kernels, microcode or GRUB change. 99- runs after 90-mkinitcpio-install, so new initramfs files are listed.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = grub
Target = amd-ucode
Target = intel-ucode
Target = grub-btrfs

[Action]
Description = Updating GRUB config...
When = PostTransaction
Depends = grub
Exec = /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg
